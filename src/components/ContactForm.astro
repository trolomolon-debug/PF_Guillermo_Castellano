---
import { useTranslations, type Lang } from "../i18n";
const lang = (Astro.currentLocale ?? "es") as Lang;
const t = useTranslations(lang);
---

<section id="contacto" class="py-10 md:py-16">
  <div class="contenedor">
    <h2 class="text-3xl sm:text-4xl md:text-5xl mb-4 font-bold text-blue-900">
      {t("contact.title")}
    </h2>
    <p class="mb-8 text-gray-600">{t("contact.text")}</p>

    <div class="max-w-xl bg-white border border-slate-200 rounded-2xl p-6 shadow-[0_10px_30px_rgba(15,23,42,0.08)]">
      <form novalidate>
        <label for="name" class="block mb-1 font-semibold text-gray-700">{t("form.name")}</label>
        <input id="name" name="name" type="text" required
          class="w-full mb-4 rounded-lg border border-slate-300 px-4 py-2 focus-visible:outline-2 focus-visible:outline-blue-700" />

        <label for="lastname" class="block mb-1 font-semibold text-gray-700">{t("form.lastname")}</label>
        <input id="lastname" name="lastname" type="text" required
          class="w-full mb-4 rounded-lg border border-slate-300 px-4 py-2 focus-visible:outline-2 focus-visible:outline-blue-700" />

        <label for="phone" class="block mb-1 font-semibold text-gray-700">{t("form.phone")}</label>
        <input id="phone" name="phone" type="tel"
          class="w-full mb-4 rounded-lg border border-slate-300 px-4 py-2 focus-visible:outline-2 focus-visible:outline-blue-700" />

        <label for="email" class="block mb-1 font-semibold text-gray-700">{t("form.email")}</label>
        <input id="email" name="email" type="email" required
          class="w-full mb-6 rounded-lg border border-slate-300 px-4 py-2 focus-visible:outline-2 focus-visible:outline-blue-700" />

        <button type="button"
          class="w-full bg-blue-700 hover:bg-blue-900 text-white font-bold rounded-lg px-5 py-3 transition focus-visible:outline-offset-2 focus-visible:outline-2 focus-visible:outline-blue-700">
          {t("form.submit")}
        </button>
      </form>
    </div>
  </div>
</section>
